# Paper-local build settings. Read by the fcktaps Makefile before its defaults,
# so anything set here wins over them and loses to the command line.

# Citation style: acmnumeric (CHI, UIST) or acmauthoryear (SIGGRAPH).
CITE_STYLE := acmnumeric

# Title image: float (full-width float after the ACM frontmatter) or teaser
# (acmart's teaser slot on the first page).
FIGURE_ONE_PLACEMENT := float

# Figure numbers set across both columns, for example "2 5". All other figures
# stay single-column.
WIDE_FIGURES :=
