@inproceedings{oka_pneumatic_2025,
	address = {New York, NY, USA},
	series = {{TEI} '25},
	title = {Pneumatic {Laser} {Origami}: {Rapid} and {Large}-{Scale} {Fabrication} of {Laser}-{Welded} {Pouch} {Motors} for {Shape}-{Changing} {Products}},
	isbn = {979-8-4007-1197-8},
	shorttitle = {Pneumatic {Laser} {Origami}},
	url = {https://dl.acm.org/doi/10.1145/3689050.3704956},
	doi = {10.1145/3689050.3704956},
	abstract = {We propose Pneumatic Laser Origami, a method to rapidly design and fabricate lightweight, self-foldable origami artifacts driven by planar pneumatic actuators called Pouch Motors\&nbsp;[18]. Compared to prior methods of building Pouch Motors with customized equipment, we developed a technique to weld two thermoplastic sheets with an off-the-shelf, non-customized laser cutter. This resulted in (1) democratized, (2) faster (\&gt; 13 times faster compared to prior methods), and (3) large-scale (85 cm length at maximum) fabrication of shape-changing products. Also, we achieved a method to linearly control the maximum folding angle of Pouch Motors (0° \&lt; θ \&lt; 95.3°) by welding extra protrusion patterns, which contributed to driving multiple Pouch Motors with one pneumatic input. To leverage these benefits, we developed the software that takes the target 3D mesh as input and inversely generates a 2D welding pattern for Pouch Motors. Finally, we demonstrated several design examples and applications using our method.},
	urldate = {2025-03-05},
	booktitle = {Proceedings of the {Nineteenth} {International} {Conference} on {Tangible}, {Embedded}, and {Embodied} {Interaction}},
	publisher = {Association for Computing Machinery},
	author = {Oka, Sora and Koyama, Kazuki and Gondo, Tomoyuki and Ikeda, Yasushi and Kawahara, Yoshihiro and Narumi, Koya},
	month = mar,
	year = {2025},
	pages = {1--12},
	file = {Full Text PDF:/Users/lukasrambold/Zotero/storage/N7ATHQH3/Oka et al. - 2025 - Pneumatic Laser Origami Rapid and Large-Scale Fabrication of Laser-Welded Pouch Motors for Shape-Ch.pdf:application/pdf},
