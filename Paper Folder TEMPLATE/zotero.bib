	keywords = {Computational fabrication, Shape-changing Interface},
	pages = {1--12},
	file = {Full Text PDF:/Users/lukasrambold/Zotero/storage/9WCKP35U/Gu et al. - 2022 - PneuMesh Pneumatic-driven Truss-based Shape Chang.pdf:application/pdf},
}

