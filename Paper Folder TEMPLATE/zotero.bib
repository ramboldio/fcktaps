	year = {2016},
	keywords = {bending mechanism, haptics, pneumatic, shape-changing interfaces, soft shape-change, textile, wearables},
	pages = {121--132},
	file = {Full Text PDF:/Users/lukasrambold/Zotero/storage/ZGQ3T4G7/Ou et al. - 2016 - aeroMorph - Heat-sealing Inflatable Shape-change M.pdf:application/pdf},
}

